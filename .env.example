# ─────────────────────────────────────────────────────────────────────────────
# MyFinance ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env dosyası ASLA sürüm kontrolüne girmemeli.
# ─────────────────────────────────────────────────────────────────────────────

# Oturum çerezlerini imzalar. En az 32 karakter olmalı.
# Üretmek için:  openssl rand -base64 48
AUTH_SECRET=

# SQLite veritabanı yolu. Docker'da /data/myfinance.db kullanılır.
DATABASE_PATH=./data/myfinance.db

# Bildirimlerdeki bağlantılar bu adresi kullanır (tünel adresiniz).
APP_URL=https://finans.ornek-alan-adiniz.com

# İlk kurulumda oluşturulacak kullanıcı.
# ADMIN_PASSWORD boş bırakılırsa rastgele bir şifre üretilir ve günlüğe yazılır.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Ben

# Yedeklerin kaç gün saklanacağı (docker-compose backup servisi)
BACKUP_KEEP_DAYS=30
