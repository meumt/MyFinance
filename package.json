{
  "name": "myfinance",
  "version": "1.0.0",
  "private": true,
  "description": "Türkiye finans sistemine uygun, self-hosted kişisel finans yönetimi",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "notify": "NODE_OPTIONS=--conditions=react-server tsx scripts/notify.ts",
    "worker": "NODE_OPTIONS=--conditions=react-server tsx scripts/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/domain.test.ts && tsx tests/ledger.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.44.2",
    "jose": "^6.0.11",
    "lucide-react": "^0.511.0",
    "next": "^15.5.22",
    "nodemailer": "^9.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.29",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "drizzle-kit": "^0.31.1",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
